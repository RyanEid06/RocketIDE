<Project>
  <PropertyGroup>
    <LangVersion>14.0</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Deterministic>true</Deterministic>
    <Version Condition="'$(Version)' == ''">1.0.0</Version>
    <AssemblyInformationalVersion Condition="'$(RocketIDEInformationalVersion)' != ''">$(RocketIDEInformationalVersion)</AssemblyInformationalVersion>
    <AssemblyInformationalVersion Condition="'$(RocketIDEInformationalVersion)' == ''">$(Version)</AssemblyInformationalVersion>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
  </PropertyGroup>
</Project>
