<Window x:Class="RocketIDE.App.Views.OutlineWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:viewModels="clr-namespace:RocketIDE.App.ViewModels"
        Title="Outline" Width="380" Height="560" MinWidth="280" MinHeight="300"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource IDE.WindowBrush}">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <TextBlock Margin="4,2,4,8" Text="{Binding StatusText}" Foreground="{DynamicResource IDE.TextMutedBrush}" TextWrapping="Wrap" />
        <TreeView x:Name="OutlineTree" Grid.Row="1" ItemsSource="{Binding Items}" Background="Transparent"
                  MouseDoubleClick="OutlineTree_MouseDoubleClick" PreviewKeyDown="OutlineTree_PreviewKeyDown">
            <TreeView.Resources>
                <HierarchicalDataTemplate DataType="{x:Type viewModels:OutlineNodeViewModel}" ItemsSource="{Binding Children}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Width="90" Text="{Binding KindText}" Foreground="{DynamicResource IDE.TextMutedBrush}" />
                        <TextBlock Text="{Binding Name}" Foreground="{DynamicResource IDE.TextBrush}" />
                    </StackPanel>
                </HierarchicalDataTemplate>
            </TreeView.Resources>
        </TreeView>
    </Grid>
</Window>
