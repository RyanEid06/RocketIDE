<UserControl x:Class="RocketIDE.App.Views.SearchPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <WrapPanel Grid.Row="0" Margin="0,0,0,6">
            <TextBox x:Name="PatternBox" Width="240" Margin="0,0,6,0" Padding="5,2"
                     Text="{Binding Pattern, UpdateSourceTrigger=PropertyChanged}" ToolTip="Search pattern" />
            <TextBox x:Name="ReplacementBox" Width="180" Margin="0,0,6,0" Padding="5,2"
                     Text="{Binding Replacement, UpdateSourceTrigger=PropertyChanged}" ToolTip="Replacement text" />
            <Button Margin="0,0,6,0" Padding="12,3" Content="Search" Click="Search_Click" />
            <Button Margin="0,0,6,0" Padding="12,3" Content="Preview Replace" Click="PreviewReplace_Click" />
            <Button Padding="12,3" Content="Apply Replace" IsEnabled="{Binding CanApplyReplace}" Click="ApplyReplace_Click" />
        </WrapPanel>
        <WrapPanel Grid.Row="1" Margin="0,0,0,6">
            <CheckBox Margin="0,0,12,0" Content="Case sensitive" IsChecked="{Binding CaseSensitive}" />
            <CheckBox Margin="0,0,12,0" Content="Whole word" IsChecked="{Binding WholeWord}" />
            <CheckBox Margin="0,0,12,0" Content="Regular expression" IsChecked="{Binding UseRegex}" />
            <TextBlock VerticalAlignment="Center" Foreground="{DynamicResource IDE.TextMutedBrush}"
                       Text="Search includes dirty open buffers." />
        </WrapPanel>
        <ListView x:Name="ResultsList" Grid.Row="2" ItemsSource="{Binding Results}" BorderThickness="0"
                  Background="Transparent" Foreground="{DynamicResource IDE.TextBrush}"
                  MouseDoubleClick="ResultsList_MouseDoubleClick">
            <ListView.View>
                <GridView AllowsColumnReorder="True">
                    <GridViewColumn Header="File" Width="230" DisplayMemberBinding="{Binding FilePath}" />
                    <GridViewColumn Header="Location" Width="90" DisplayMemberBinding="{Binding Location}" />
                    <GridViewColumn Header="Preview" Width="520" DisplayMemberBinding="{Binding Preview}" />
                </GridView>
            </ListView.View>
        </ListView>
        <TextBlock Grid.Row="3" Margin="4,6,4,0" Foreground="{DynamicResource IDE.TextMutedBrush}"
                   FontSize="11" Text="{Binding StatusText}" />
    </Grid>
</UserControl>
