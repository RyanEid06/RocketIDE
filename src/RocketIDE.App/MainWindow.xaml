<Window x:Class="RocketIDE.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:editor="clr-namespace:RocketIDE.App.Editor"
        xmlns:explorer="clr-namespace:RocketIDE.App.ViewModels.Explorer"
        xmlns:viewModels="clr-namespace:RocketIDE.App.ViewModels"
        xmlns:views="clr-namespace:RocketIDE.App.Views"
        Title="{Binding WindowTitle}"
        Width="1280" Height="800" MinWidth="900" MinHeight="600"
        WindowStartupLocation="Manual"
        Loaded="MainWindow_Loaded"
        SourceInitialized="MainWindow_SourceInitialized"
        PreviewKeyDown="MainWindow_PreviewKeyDown"
        Closing="MainWindow_Closing">
    <DockPanel LastChildFill="True">
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="_File">
                <MenuItem Header="_New File" InputGestureText="Ctrl+N" Click="NewFile_Click" />
                <MenuItem Header="New _Folder" IsEnabled="{Binding HasWorkspace}" Click="NewFolder_Click" />
                <Separator />
                <MenuItem Header="_Open File..." InputGestureText="Ctrl+O" Click="OpenFile_Click" />
                <MenuItem Header="Open _Folder..." InputGestureText="Ctrl+Shift+O" Click="OpenFolder_Click" />
                <MenuItem Header="_Quick Open File..." InputGestureText="Ctrl+P" IsEnabled="{Binding CanQuickOpen}" Tag="workspace.quickOpen" Click="RegisteredCommand_Click" />
                <MenuItem x:Name="RecentProjectsMenu" Header="Recent _Projects" SubmenuOpened="RecentProjects_SubmenuOpened" />
                <MenuItem Header="_Reopen Closed Editor" Click="ReopenClosedEditor_Click" />
                <Separator />
                <MenuItem Header="_Save" InputGestureText="Ctrl+S" IsEnabled="{Binding HasDocuments}" Click="Save_Click" />
                <MenuItem Header="Save _All" InputGestureText="Ctrl+Shift+S" IsEnabled="{Binding HasDocuments}" Click="SaveAll_Click" />
                <Separator />
                <MenuItem Header="_Close" InputGestureText="Ctrl+W" IsEnabled="{Binding HasDocuments}" Click="Close_Click" />
                <MenuItem Header="Close _Others" IsEnabled="{Binding HasDocuments}" Click="CloseOthers_Click" />
                <MenuItem Header="Close A_ll" InputGestureText="Ctrl+Shift+W" IsEnabled="{Binding HasDocuments}" Click="CloseAll_Click" />
                <Separator />
                <MenuItem Header="E_xit" Click="Exit_Click" />
            </MenuItem>
            <MenuItem Header="_Edit">
                <MenuItem Header="_Undo" InputGestureText="Ctrl+Z" IsEnabled="{Binding HasDocuments}" Tag="editor.undo" Click="RegisteredCommand_Click" />
                <MenuItem Header="_Redo" InputGestureText="Ctrl+Y" IsEnabled="{Binding HasDocuments}" Tag="editor.redo" Click="RegisteredCommand_Click" />
                <Separator />
                <MenuItem Header="_Find..." InputGestureText="Ctrl+F" IsEnabled="{Binding HasDocuments}" Tag="editor.find" Click="RegisteredCommand_Click" />
                <MenuItem Header="_Replace..." InputGestureText="Ctrl+H" IsEnabled="{Binding HasDocuments}" Tag="editor.replace" Click="RegisteredCommand_Click" />
                <Separator />
                <MenuItem Header="Toggle Line _Comment" IsEnabled="{Binding ActiveDocument.AllowLocalEditing}" Click="ToggleLineComment_Click" />
                <MenuItem Header="_Duplicate Line / Selection" IsEnabled="{Binding ActiveDocument.AllowLocalEditing}" Click="DuplicateLineOrSelection_Click" />
                <MenuItem Header="Move Line / Selection _Up" IsEnabled="{Binding ActiveDocument.AllowLocalEditing}" Click="MoveLineOrSelectionUp_Click" />
                <MenuItem Header="Move Line / Selection _Down" IsEnabled="{Binding ActiveDocument.AllowLocalEditing}" Click="MoveLineOrSelectionDown_Click" />
                <MenuItem Header="Delete Line / _Selection" IsEnabled="{Binding ActiveDocument.AllowLocalEditing}" Click="DeleteLineOrSelection_Click" />
                <Separator />
                <MenuItem Header="Search in _Workspace..." InputGestureText="Ctrl+Shift+F" Tag="workspace.search" Click="RegisteredCommand_Click" />
                <MenuItem Header="Replace in _Files..." InputGestureText="Ctrl+Shift+H" Tag="workspace.replace" Click="RegisteredCommand_Click" />
                <Separator />
                <MenuItem Style="{StaticResource IDE.MenuItemStyle}" Header="Rename _Symbol..." InputGestureText="F2" IsEnabled="{Binding HasDocuments}" Tag="editor.renameSymbol" Click="RegisteredCommand_Click" />
                <MenuItem Style="{StaticResource IDE.MenuItemStyle}" Header="_Quick Fixes (server-provided)" InputGestureText="Ctrl+." IsEnabled="{Binding HasDocuments}" Tag="editor.codeActions" Click="RegisteredCommand_Click" />
                <MenuItem Style="{StaticResource IDE.MenuItemStyle}" Header="_Format Document" InputGestureText="Shift+Alt+F" IsEnabled="{Binding HasDocuments}" Tag="editor.formatDocument" Click="RegisteredCommand_Click" />
            </MenuItem>
            <MenuItem Header="_Selection"><MenuItem Header="Select _All" InputGestureText="Ctrl+A" IsEnabled="{Binding HasDocuments}" Tag="editor.selectAll" Click="RegisteredCommand_Click" /></MenuItem>
            <MenuItem Header="_View">
                <MenuItem x:Name="ExplorerViewMenu" Header="Explorer" IsCheckable="True" IsChecked="True" Click="ExplorerViewMenu_Click" />
                <MenuItem x:Name="BottomPanelViewMenu" Header="Bottom Panel" IsCheckable="True" IsChecked="True" Click="BottomPanelViewMenu_Click" />
                <Separator />
                <MenuItem Header="Zoom _In" Click="ZoomIn_Click" />
                <MenuItem Header="Zoom _Out" Click="ZoomOut_Click" />
                <MenuItem Header="_Reset Zoom" Click="ZoomReset_Click" />
                <MenuItem x:Name="WordWrapViewMenu" Header="_Word Wrap" IsCheckable="True" Click="WordWrap_Click" />
                <MenuItem x:Name="FormatOnSaveViewMenu" Header="_Format on Save" IsCheckable="True" Click="FormatOnSave_Click" />
                <Separator />
                <MenuItem Header="Collapse Explorer _All" IsEnabled="{Binding HasWorkspace}" Click="CollapseAllExplorer_Click" />
                <MenuItem Header="Reveal _Active File" IsEnabled="{Binding HasDocuments}" Click="RevealActiveFile_Click" />
                <Separator />
                <MenuItem Header="_Problems" InputGestureText="Ctrl+Shift+M" Tag="view.problems" Click="RegisteredCommand_Click" />
                <MenuItem Header="_Output" InputGestureText="Ctrl+Shift+U" Tag="view.output" Click="RegisteredCommand_Click" />
                <MenuItem Header="_Outline" Tag="view.outline" Click="RegisteredCommand_Click" />
                <MenuItem Header="Command _Palette..." InputGestureText="Ctrl+Shift+P" Tag="view.commandPalette" Click="RegisteredCommand_Click" />
            </MenuItem>
            <MenuItem Header="_Navigate">
                <MenuItem Style="{StaticResource IDE.MenuItemStyle}" Header="_Go to Definition" InputGestureText="F12" IsEnabled="{Binding HasDocuments}" Tag="navigate.definition" Click="RegisteredCommand_Click" />
                <MenuItem Style="{StaticResource IDE.MenuItemStyle}" Header="Find _References" InputGestureText="Shift+F12" IsEnabled="{Binding HasDocuments}" Tag="navigate.references" Click="RegisteredCommand_Click" />
                <MenuItem Header="Symbol in _File..." Tag="navigate.symbolFile" Click="RegisteredCommand_Click" />
                <MenuItem Header="Symbol in _Workspace..." InputGestureText="Ctrl+T" Tag="navigate.symbolWorkspace" Click="RegisteredCommand_Click" />
                <Separator />
                <MenuItem Header="_Back" InputGestureText="Alt+Left" Tag="navigate.back" Click="RegisteredCommand_Click" />
                <MenuItem Header="_Forward" InputGestureText="Alt+Right" Tag="navigate.forward" Click="RegisteredCommand_Click" />
                <Separator />
                <MenuItem Style="{StaticResource IDE.MenuItemStyle}" Header="_Go to Line..." InputGestureText="Ctrl+G" IsEnabled="{Binding HasDocuments}" Tag="navigate.goToLine" Click="RegisteredCommand_Click" />
            </MenuItem>
            <MenuItem Header="_Build">
                <MenuItem Header="_Check Rocket Target" IsEnabled="{Binding CanRocketCheck}" Tag="rocket.check" Click="RegisteredCommand_Click" />
                <MenuItem Header="_Build Rocket Target" InputGestureText="Ctrl+B" IsEnabled="{Binding CanRocketBuild}" Tag="rocket.build" Click="RegisteredCommand_Click" />
            </MenuItem>
            <MenuItem Header="_Run">
                <MenuItem Header="_Run Rocket Target" InputGestureText="Ctrl+R" IsEnabled="{Binding CanRocketRun}" Tag="rocket.run" Click="RegisteredCommand_Click" />
                <MenuItem Header="_Stop Rocket" InputGestureText="Ctrl+Shift+F5" IsEnabled="{Binding CanRocketStop}" Tag="rocket.stop" Click="RegisteredCommand_Click" />
                <Separator />
                <MenuItem Header="_Test Rocket Target" IsEnabled="{Binding CanRocketTest}" Tag="rocket.test" Click="RegisteredCommand_Click" />
            </MenuItem>
            <MenuItem Header="_Debug">
                <MenuItem Header="_Start / Continue" InputGestureText="F5" IsEnabled="{Binding CanDebugStartContinue}" Tag="debug.startContinue" Click="RegisteredCommand_Click" />
                <MenuItem Header="_Pause" InputGestureText="Pause" IsEnabled="{Binding CanDebugPause}" Tag="debug.pause" Click="RegisteredCommand_Click" />
                <MenuItem Header="S_top" InputGestureText="Shift+F5" IsEnabled="{Binding CanDebugStop}" Tag="debug.stop" Click="RegisteredCommand_Click" />
                <Separator />
                <MenuItem Header="Toggle _Breakpoint" InputGestureText="F9" IsEnabled="{Binding CanDebugToggleBreakpoint}" Tag="debug.toggleBreakpoint" Click="RegisteredCommand_Click" />
                <Separator />
                <MenuItem Header="Step _Over" InputGestureText="F10" IsEnabled="{Binding CanDebugStepOver}" Tag="debug.stepOver" Click="RegisteredCommand_Click" />
                <MenuItem Header="Step _Into" InputGestureText="F11" IsEnabled="{Binding CanDebugStepInto}" Tag="debug.stepInto" Click="RegisteredCommand_Click" />
                <MenuItem Header="Step O_ut" InputGestureText="Shift+F11" IsEnabled="{Binding CanDebugStepOut}" Tag="debug.stepOut" Click="RegisteredCommand_Click" />
            </MenuItem>
            <MenuItem Header="_Tools">
                <MenuItem Header="Validate Rocket _Environment" Click="ValidateRocketEnvironment_Click" />
                <MenuItem Header="Rocket SDK _Settings..." Click="RocketSdkSettings_Click" />
                <Separator />
                <MenuItem Header="_New Rocket Project..." IsEnabled="{Binding CanRocketNewProject}" Tag="rocket.new" Click="RegisteredCommand_Click" />
                <MenuItem Header="_Resolve Dependencies" IsEnabled="{Binding CanRocketAdvanced}">
                    <MenuItem Header="_Normal" Tag="rocket.resolve" Click="RegisteredCommand_Click" />
                    <MenuItem Header="_Locked (--locked)" Click="ResolveDependenciesLocked_Click" />
                    <MenuItem Header="_Offline (--offline)" Click="ResolveDependenciesOffline_Click" />
                </MenuItem>
                <MenuItem Header="Dependency _Tree" IsEnabled="{Binding CanRocketAdvanced}" Tag="rocket.tree" Click="RegisteredCommand_Click" />
                <MenuItem Header="_Audit Dependencies" IsEnabled="{Binding CanRocketAdvanced}" Tag="rocket.audit" Click="RegisteredCommand_Click" />
                <MenuItem Header="_Target Information" IsEnabled="{Binding CanRocketAdvanced}" Tag="rocket.target" Click="RegisteredCommand_Click" />
                <MenuItem Header="Format _Target/Workspace" IsEnabled="{Binding CanRocketAdvanced}" Tag="rocket.format" Click="RegisteredCommand_Click" />
                <MenuItem Header="_Coverage" IsEnabled="{Binding CanRocketAdvanced}" Tag="rocket.coverage" Click="RegisteredCommand_Click" />
                <MenuItem Header="_Profile" IsEnabled="{Binding CanRocketAdvanced}" Tag="rocket.profile" Click="RegisteredCommand_Click" />
                <MenuItem Header="_Benchmark" IsEnabled="{Binding CanRocketAdvanced}" Tag="rocket.benchmark" Click="RegisteredCommand_Click" />
            </MenuItem>
            <MenuItem Header="_Help"><MenuItem Header="About RocketIDE" Click="About_Click" /></MenuItem>
        </Menu>

        <Border DockPanel.Dock="Top" Background="{DynamicResource IDE.ChromeBrush}" BorderBrush="{DynamicResource IDE.BorderBrush}" BorderThickness="0,0,0,1" Padding="5,2">
            <StackPanel Orientation="Horizontal">
                <Button Style="{StaticResource IDE.ToolbarButtonStyle}" Content="New" ToolTip="New file" AutomationProperties.Name="New file button" Click="NewFile_Click" />
                <Button Style="{StaticResource IDE.ToolbarButtonStyle}" Content="Open" ToolTip="Open file" AutomationProperties.Name="Open file button" Click="OpenFile_Click" />
                <Button Style="{StaticResource IDE.ToolbarButtonStyle}" Content="Folder" ToolTip="Open folder" AutomationProperties.Name="Open folder button" Click="OpenFolder_Click" />
                <Button Style="{StaticResource IDE.ToolbarButtonStyle}" Content="Save" IsEnabled="{Binding HasDocuments}" ToolTip="Save active file" AutomationProperties.Name="Save active file button" Click="Save_Click" />
                <Border Width="1" Height="22" Margin="5,0" Background="{DynamicResource IDE.BorderBrush}" />
                <Button Style="{StaticResource IDE.ToolbarButtonStyle}" Content="Build" IsEnabled="{Binding CanRocketBuild}" ToolTip="Build active Rocket target" Tag="rocket.build" Click="RegisteredCommand_Click" />
                <Button Style="{StaticResource IDE.ToolbarButtonStyle}" Content="Run" IsEnabled="{Binding CanRocketRun}" ToolTip="Run active Rocket executable target" Tag="rocket.run" Click="RegisteredCommand_Click" />
                <Button Style="{StaticResource IDE.ToolbarButtonStyle}" Content="Debug" IsEnabled="{Binding CanDebugStartContinue}" ToolTip="Start or continue Rocket debugging (F5)" AutomationProperties.Name="Start or continue Rocket debugging button" Tag="debug.startContinue" Click="RegisteredCommand_Click" />
                <Button Style="{StaticResource IDE.ToolbarButtonStyle}" Content="Pause" IsEnabled="{Binding CanDebugPause}" ToolTip="Pause Rocket debugging" AutomationProperties.Name="Pause Rocket debugging button" Tag="debug.pause" Click="RegisteredCommand_Click" />
                <Button Style="{StaticResource IDE.ToolbarButtonStyle}" Content="Stop Debug" IsEnabled="{Binding CanDebugStop}" ToolTip="Stop Rocket debugging (Shift+F5)" AutomationProperties.Name="Stop Rocket debugging button" Tag="debug.stop" Click="RegisteredCommand_Click" />
                <Button Style="{StaticResource IDE.ToolbarButtonStyle}" Content="Stop" IsEnabled="{Binding CanRocketStop}" ToolTip="Stop active Rocket compiler/program process tree" AutomationProperties.Name="Stop Rocket compiler or program button" Tag="rocket.stop" Click="RegisteredCommand_Click" />
                <Button Style="{StaticResource IDE.ToolbarButtonStyle}" Content="Test" IsEnabled="{Binding CanRocketTest}" ToolTip="Test active Rocket target" Tag="rocket.test" Click="RegisteredCommand_Click" />
            </StackPanel>
        </Border>

        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem Content="{Binding RocketSdkStatus}" /><Separator />
            <StatusBarItem Content="{Binding LspStatus}" /><Separator />
            <StatusBarItem Content="{Binding ActiveTargetStatus}" /><Separator />
            <StatusBarItem Content="{Binding CaretStatus}" /><Separator />
            <StatusBarItem Content="{Binding EncodingStatus}" />
        </StatusBar>

        <Grid Background="{DynamicResource IDE.WindowBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="ExplorerColumnDefinition" Width="250" MinWidth="170" />
                <ColumnDefinition x:Name="ExplorerSplitterColumnDefinition" Width="5" />
                <ColumnDefinition Width="*" MinWidth="420" />
            </Grid.ColumnDefinitions>

            <Border x:Name="ExplorerPane" Grid.Column="0" Background="{DynamicResource IDE.ChromeBrush}" BorderBrush="{DynamicResource IDE.BorderBrush}" BorderThickness="0,0,1,0">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Padding="12,9" BorderBrush="{DynamicResource IDE.BorderBrush}" BorderThickness="0,0,0,1">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Style="{StaticResource IDE.SmallButtonStyle}" Content="↻" ToolTip="Refresh workspace" AutomationProperties.Name="Refresh workspace" IsEnabled="{Binding HasWorkspace}" Click="RefreshWorkspace_Click" />
                            <TextBlock Text="EXPLORER" FontWeight="SemiBold" FontSize="11" Foreground="{DynamicResource IDE.TextMutedBrush}" VerticalAlignment="Center" />
                        </DockPanel>
                    </Border>

                    <Grid>
                        <StackPanel Margin="12">
                            <StackPanel.Style>
                                <Style TargetType="{x:Type StackPanel}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers><DataTrigger Binding="{Binding HasWorkspace}" Value="False"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <TextBlock Text="No workspace open" FontWeight="SemiBold" />
                            <TextBlock Margin="0,6,0,12" Foreground="{DynamicResource IDE.TextMutedBrush}" Text="Open a Rocket project or folder to browse and edit its files." TextWrapping="Wrap" />
                            <Button HorizontalAlignment="Left" Style="{StaticResource IDE.ToolbarButtonStyle}" Content="Open Folder..." Click="OpenFolder_Click" />
                        </StackPanel>

                        <TreeView x:Name="ExplorerTree" ItemsSource="{Binding Explorer.Roots}" Background="Transparent" BorderThickness="0" Padding="4" SelectedItemChanged="ExplorerTree_SelectedItemChanged" MouseDoubleClick="ExplorerTree_MouseDoubleClick" PreviewMouseRightButtonDown="ExplorerTree_PreviewMouseRightButtonDown">
                            <TreeView.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="New File" Click="NewFile_Click" />
                                    <MenuItem Header="New Folder" Click="NewFolder_Click" />
                                    <Separator />
                                    <MenuItem Header="Rename" Click="RenameExplorerItem_Click" />
                                    <MenuItem Header="Delete" Click="DeleteExplorerItem_Click" />
                                    <Separator />
                                    <MenuItem Header="Copy Path" Click="CopyExplorerPath_Click" />
                                    <MenuItem Header="Reveal in File Explorer" Click="RevealExplorerItem_Click" />
                                    <MenuItem Header="Refresh" Click="RefreshWorkspace_Click" />
                                </ContextMenu>
                            </TreeView.ContextMenu>
                            <TreeView.Resources>
                                <HierarchicalDataTemplate DataType="{x:Type explorer:ExplorerNodeViewModel}" ItemsSource="{Binding Children}">
                                    <TextBlock Text="{Binding Name}" Foreground="{DynamicResource IDE.TextBrush}" />
                                </HierarchicalDataTemplate>
                            </TreeView.Resources>
                            <TreeView.ItemContainerStyle>
                                <Style TargetType="{x:Type TreeViewItem}" BasedOn="{StaticResource {x:Type TreeViewItem}}">
                                    <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                                    <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
                                    <EventSetter Event="Expanded" Handler="ExplorerNode_Expanded" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsPlaceholder}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TreeView.ItemContainerStyle>
                            <TreeView.Style>
                                <Style TargetType="{x:Type TreeView}">
                                    <Setter Property="Visibility" Value="Visible" />
                                    <Style.Triggers><DataTrigger Binding="{Binding HasWorkspace}" Value="False"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers>
                                </Style>
                            </TreeView.Style>
                        </TreeView>
                    </Grid>
                </DockPanel>
            </Border>

            <GridSplitter x:Name="ExplorerSplitter" Grid.Column="1" Width="5" HorizontalAlignment="Stretch" ResizeDirection="Columns" />

            <Grid Grid.Column="2">
                <Grid.RowDefinitions><RowDefinition Height="*" MinHeight="260" /><RowDefinition Height="5" /><RowDefinition x:Name="BottomPanelRowDefinition" Height="190" MinHeight="100" /></Grid.RowDefinitions>
                <Grid Grid.Row="0" Background="{DynamicResource IDE.EditorBrush}">
                    <TabControl x:Name="EditorTabs" ItemsSource="{Binding Documents}" SelectedItem="{Binding ActiveDocument, Mode=TwoWay}">
                        <TabControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type viewModels:DocumentTabViewModel}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock VerticalAlignment="Center" Text="{Binding HeaderText}" />
                                    <Button Margin="7,0,0,0" Padding="2,0" MinWidth="18" Height="18" Background="Transparent" BorderBrush="Transparent" Foreground="{DynamicResource IDE.TextMutedBrush}" Content="×" ToolTip="Close" AutomationProperties.Name="Close document button" Tag="{Binding}" Click="CloseTabButton_Click" />
                                </StackPanel>
                            </DataTemplate>
                        </TabControl.ItemTemplate>
                        <TabControl.ContentTemplate><DataTemplate DataType="{x:Type viewModels:DocumentTabViewModel}"><editor:EditorDocumentHost FeatureService="{Binding RelativeSource={RelativeSource AncestorType={x:Type Window}}, Path=RocketEditorFeatures}" RocketCommandRequested="EditorHost_RocketCommandRequested" /></DataTemplate></TabControl.ContentTemplate>
                    </TabControl>
                    <Border Background="{DynamicResource IDE.ChromeBrush}" BorderBrush="{DynamicResource IDE.WarningBrush}" BorderThickness="1"
                            Margin="14,10,14,0" Padding="9,6" VerticalAlignment="Top" HorizontalAlignment="Stretch">
                        <Border.Style>
                            <Style TargetType="{x:Type Border}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ActiveDocument.IsLargeFileMode}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="{Binding ActiveDocument.LargeFileReason}" TextWrapping="Wrap" Foreground="{DynamicResource IDE.TextBrush}" />
                    </Border>
                    <Border Background="{DynamicResource IDE.EditorBrush}">
                        <Border.Style><Style TargetType="{x:Type Border}"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding HasDocuments}" Value="False"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></Border.Style>
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Width="520">
                            <TextBlock Text="RocketIDE" FontSize="34" FontWeight="SemiBold" Foreground="{DynamicResource IDE.TextBrush}" HorizontalAlignment="Center" />
                            <TextBlock Margin="0,10,0,0" Text="Native Windows IDE for the Rocket language" Foreground="{DynamicResource IDE.TextMutedBrush}" FontSize="16" HorizontalAlignment="Center" />
                            <TextBlock Margin="0,24,0,0" Text="Open a folder to browse a Rocket project, or open an individual Rocket file. Language intelligence and Rocket Check/Build/Run/Test activate when a valid target is available." Foreground="{DynamicResource IDE.TextMutedBrush}" TextWrapping="Wrap" TextAlignment="Center" />
                        </StackPanel>
                    </Border>
                </Grid>
                <GridSplitter x:Name="BottomPanelSplitter" Grid.Row="1" Height="5" VerticalAlignment="Stretch" HorizontalAlignment="Stretch" ResizeDirection="Rows" />
                <TabControl x:Name="BottomTabs" Grid.Row="2">
                    <TabItem Header="{Binding Problems.HeaderText}">
                        <Grid Margin="8">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <DockPanel Grid.Row="0" Margin="0,0,0,6" LastChildFill="True">
                                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                                    <CheckBox Margin="2,0,10,0" Content="Errors" IsChecked="{Binding Problems.ShowErrors}" />
                                    <CheckBox Margin="0,0,10,0" Content="Warnings" IsChecked="{Binding Problems.ShowWarnings}" />
                                    <CheckBox Margin="0,0,10,0" Content="Info" IsChecked="{Binding Problems.ShowInformation}" />
                                    <CheckBox Margin="0,0,14,0" Content="Hints" IsChecked="{Binding Problems.ShowHints}" />
                                    <CheckBox Margin="0,0,14,0" Content="Group by file" IsChecked="{Binding Problems.GroupByFile}" />
                                </StackPanel>
                                <TextBox MinWidth="160" MaxWidth="320" Margin="6,0,2,0" Padding="5,2"
                                         Text="{Binding Problems.FilterText, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="Filter Problems by code, message, source, or file" />
                            </DockPanel>
                            <ListView x:Name="ProblemsList" Grid.Row="1" ItemsSource="{Binding Problems.ItemsView}"
                                      BorderThickness="0" Background="Transparent"
                                      Foreground="{DynamicResource IDE.TextBrush}"
                                      MouseDoubleClick="ProblemsList_MouseDoubleClick"
                                      PreviewKeyDown="ProblemsList_PreviewKeyDown">
                                <ListView.GroupStyle>
                                    <GroupStyle>
                                        <GroupStyle.HeaderTemplate>
                                            <DataTemplate>
                                                <TextBlock Margin="4,5,4,2" FontWeight="SemiBold" Foreground="{DynamicResource IDE.TextBrush}" Text="{Binding Name}" />
                                            </DataTemplate>
                                        </GroupStyle.HeaderTemplate>
                                    </GroupStyle>
                                </ListView.GroupStyle>
                                <ListView.View>
                                    <GridView AllowsColumnReorder="True">
                                        <GridViewColumn Header="Severity" Width="80">
                                            <GridViewColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding SeverityText}" FontWeight="SemiBold">
                                                        <TextBlock.Style>
                                                            <Style TargetType="{x:Type TextBlock}">
                                                                <Setter Property="Foreground" Value="{DynamicResource IDE.TextBrush}" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding SeverityText}" Value="Error">
                                                                        <Setter Property="Foreground" Value="{DynamicResource IDE.ErrorBrush}" />
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding SeverityText}" Value="Warning">
                                                                        <Setter Property="Foreground" Value="{DynamicResource IDE.WarningBrush}" />
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding SeverityText}" Value="Information">
                                                                        <Setter Property="Foreground" Value="{DynamicResource IDE.InfoBrush}" />
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding SeverityText}" Value="Hint">
                                                                        <Setter Property="Foreground" Value="{DynamicResource IDE.TextMutedBrush}" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </DataTemplate>
                                            </GridViewColumn.CellTemplate>
                                        </GridViewColumn>
                                        <GridViewColumn Header="Code" Width="72" DisplayMemberBinding="{Binding Code}" />
                                        <GridViewColumn Header="Message" Width="360" DisplayMemberBinding="{Binding Message}" />
                                        <GridViewColumn Header="File" Width="160" DisplayMemberBinding="{Binding FileName}" />
                                        <GridViewColumn Header="Line" Width="52" DisplayMemberBinding="{Binding Line}" />
                                        <GridViewColumn Header="Col" Width="48" DisplayMemberBinding="{Binding Column}" />
                                        <GridViewColumn Header="Source" Width="110" DisplayMemberBinding="{Binding SourceText}" />
                                    </GridView>
                                </ListView.View>
                            </ListView>
                            <TextBlock Grid.Row="2" Margin="4,5,4,0" Foreground="{DynamicResource IDE.TextMutedBrush}" FontSize="11"
                                       Text="{Binding Problems.StatusText}" />
                        </Grid>
                    </TabItem>
                    <TabItem Header="{Binding References.HeaderText}">
                        <views:ReferencesPanel DataContext="{Binding References}" ReferenceInvoked="ReferencesPanel_ReferenceInvoked" />
                    </TabItem>
                    <TabItem Header="OUTPUT">
                        <Grid Margin="8">
                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                            <DockPanel Grid.Row="0" Margin="0,0,0,6">
                                <TextBlock VerticalAlignment="Center" Text="Rocket compiler, program, debugger, environment, and language-server output" Foreground="{DynamicResource IDE.TextMutedBrush}" />
                                <Button DockPanel.Dock="Right" Style="{StaticResource IDE.SmallButtonStyle}" Content="Clear" Click="ClearOutput_Click" />
                            </DockPanel>
                            <ListBox x:Name="OutputList" Grid.Row="1" ItemsSource="{Binding Output.Lines}" SelectionMode="Extended" BorderThickness="0" Background="Transparent" FontFamily="Consolas" FontSize="12" ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Auto" PreviewKeyDown="OutputList_PreviewKeyDown">
                                <ListBox.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="Copy Selected" Click="CopyOutputSelected_Click" />
                                        <MenuItem Header="Copy All" Click="CopyOutputAll_Click" />
                                    </ContextMenu>
                                </ListBox.ContextMenu>
                            </ListBox>
                        </Grid>
                    </TabItem>
                    <TabItem Header="{Binding Tests.HeaderText}">
                        <Grid Margin="8">
                            <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                            <ListView Grid.Row="0" ItemsSource="{Binding Tests.Items}" BorderThickness="0" Background="Transparent" Foreground="{DynamicResource IDE.TextBrush}">
                                <ListView.View>
                                    <GridView>
                                        <GridViewColumn Header="Status" Width="90" DisplayMemberBinding="{Binding Status}" />
                                        <GridViewColumn Header="Test" Width="360" DisplayMemberBinding="{Binding Name}" />
                                        <GridViewColumn Header="Exit" Width="60" DisplayMemberBinding="{Binding ExitCode}" />
                                    </GridView>
                                </ListView.View>
                            </ListView>
                            <TextBlock Grid.Row="1" Margin="4,5,4,0" Foreground="{DynamicResource IDE.TextMutedBrush}" FontSize="11" Text="{Binding Tests.SummaryText}" />
                        </Grid>
                    </TabItem>
                    <TabItem Header="SEARCH">
                        <views:SearchPanel x:Name="SearchPanelControl" DataContext="{Binding Search}" />
                    </TabItem>
                    <TabItem Header="DEBUG">
                        <Grid Margin="8">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Margin="4,0,4,6" Foreground="{DynamicResource IDE.TextMutedBrush}" Text="{Binding Debug.StatusText}" />
                            <Grid Grid.Row="1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="0.8*" MinWidth="160" />
                                    <ColumnDefinition Width="1.4*" MinWidth="220" />
                                    <ColumnDefinition Width="1.4*" MinWidth="220" />
                                </Grid.ColumnDefinitions>
                                <GroupBox Grid.Column="0" Header="Threads" Margin="0,0,6,0">
                                    <ListView x:Name="DebugThreadsList" ItemsSource="{Binding Debug.Threads}" BorderThickness="0" Background="Transparent" MouseDoubleClick="DebugThreads_MouseDoubleClick">
                                        <ListView.View><GridView><GridViewColumn Header="Thread" Width="180" DisplayMemberBinding="{Binding DisplayName}" /></GridView></ListView.View>
                                    </ListView>
                                </GroupBox>
                                <GroupBox Grid.Column="1" Header="Call Stack" Margin="0,0,6,0">
                                    <ListView x:Name="DebugFramesList" ItemsSource="{Binding Debug.Frames}" BorderThickness="0" Background="Transparent" MouseDoubleClick="DebugFrames_MouseDoubleClick">
                                        <ListView.View><GridView>
                                            <GridViewColumn Header="#" Width="36" DisplayMemberBinding="{Binding Index}" />
                                            <GridViewColumn Header="Function" Width="190" DisplayMemberBinding="{Binding FunctionName}" />
                                            <GridViewColumn Header="Line" Width="55" DisplayMemberBinding="{Binding Line}" />
                                        </GridView></ListView.View>
                                    </ListView>
                                </GroupBox>
                                <GroupBox Grid.Column="2" Header="Locals">
                                    <ListView ItemsSource="{Binding Debug.Locals}" BorderThickness="0" Background="Transparent">
                                        <ListView.View><GridView>
                                            <GridViewColumn Header="Name" Width="120" DisplayMemberBinding="{Binding Name}" />
                                            <GridViewColumn Header="Type" Width="110" DisplayMemberBinding="{Binding Type}" />
                                            <GridViewColumn Header="Value" Width="190" DisplayMemberBinding="{Binding Value}" />
                                        </GridView></ListView.View>
                                    </ListView>
                                </GroupBox>
                            </Grid>
                        </Grid>
                    </TabItem>
                </TabControl>
            </Grid>
        </Grid>
    </DockPanel>
</Window>
