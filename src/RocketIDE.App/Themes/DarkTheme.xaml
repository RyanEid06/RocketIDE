<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Color x:Key="IDE.Color.Window">#FF181A1F</Color>
    <Color x:Key="IDE.Color.Chrome">#FF20232A</Color>
    <Color x:Key="IDE.Color.ChromeRaised">#FF282C34</Color>
    <Color x:Key="IDE.Color.Editor">#FF16181D</Color>
    <Color x:Key="IDE.Color.Border">#FF343944</Color>
    <Color x:Key="IDE.Color.Text">#FFE7EAF0</Color>
    <Color x:Key="IDE.Color.TextMuted">#FF98A0AD</Color>
    <Color x:Key="IDE.Color.Selection">#FF264F78</Color>
    <Color x:Key="IDE.Color.Hover">#FF323744</Color>
    <Color x:Key="IDE.Color.Accent">#FF6CB6FF</Color>
    <Color x:Key="IDE.Color.Error">#FFFF6B6B</Color>
    <Color x:Key="IDE.Color.Warning">#FFFFC857</Color>
    <Color x:Key="IDE.Color.Info">#FF6CB6FF</Color>
    <Color x:Key="IDE.Color.Success">#FF62D39B</Color>

    <SolidColorBrush x:Key="IDE.WindowBrush" Color="{StaticResource IDE.Color.Window}" />
    <SolidColorBrush x:Key="IDE.ChromeBrush" Color="{StaticResource IDE.Color.Chrome}" />
    <SolidColorBrush x:Key="IDE.ChromeRaisedBrush" Color="{StaticResource IDE.Color.ChromeRaised}" />
    <SolidColorBrush x:Key="IDE.EditorBrush" Color="{StaticResource IDE.Color.Editor}" />
    <SolidColorBrush x:Key="IDE.BorderBrush" Color="{StaticResource IDE.Color.Border}" />
    <SolidColorBrush x:Key="IDE.TextBrush" Color="{StaticResource IDE.Color.Text}" />
    <SolidColorBrush x:Key="IDE.TextMutedBrush" Color="{StaticResource IDE.Color.TextMuted}" />
    <SolidColorBrush x:Key="IDE.SelectionBrush" Color="{StaticResource IDE.Color.Selection}" />
    <SolidColorBrush x:Key="IDE.HoverBrush" Color="{StaticResource IDE.Color.Hover}" />
    <SolidColorBrush x:Key="IDE.AccentBrush" Color="{StaticResource IDE.Color.Accent}" />
    <SolidColorBrush x:Key="IDE.ErrorBrush" Color="{StaticResource IDE.Color.Error}" />
    <SolidColorBrush x:Key="IDE.WarningBrush" Color="{StaticResource IDE.Color.Warning}" />
    <SolidColorBrush x:Key="IDE.InfoBrush" Color="{StaticResource IDE.Color.Info}" />
    <SolidColorBrush x:Key="IDE.SuccessBrush" Color="{StaticResource IDE.Color.Success}" />

    <Style TargetType="{x:Type Window}">
        <Setter Property="Background" Value="{DynamicResource IDE.WindowBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource IDE.TextBrush}" />
        <Setter Property="FontFamily" Value="Segoe UI" />
        <Setter Property="FontSize" Value="13" />
    </Style>

    <Style TargetType="{x:Type Menu}">
        <Setter Property="Background" Value="{DynamicResource IDE.ChromeBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource IDE.TextBrush}" />
        <Setter Property="Padding" Value="4,2" />
    </Style>

    <Style TargetType="{x:Type ContextMenu}">
        <Setter Property="Background" Value="{DynamicResource IDE.ChromeRaisedBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource IDE.TextBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource IDE.BorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="2" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <ControlTemplate x:Key="IDE.TopLevelMenuItemTemplate" TargetType="{x:Type MenuItem}">
        <Grid SnapsToDevicePixels="True">
            <Border x:Name="OuterBorder"
                    Background="{TemplateBinding Background}"
                    BorderBrush="Transparent"
                    BorderThickness="1"
                    Padding="{TemplateBinding Padding}">
                <ContentPresenter ContentSource="Header"
                                  RecognizesAccessKey="True"
                                  VerticalAlignment="Center"
                                  HorizontalAlignment="Left" />
            </Border>
            <Popup x:Name="PART_Popup"
                   AllowsTransparency="True"
                   Focusable="False"
                   IsOpen="{Binding IsSubmenuOpen, RelativeSource={RelativeSource TemplatedParent}}"
                   Placement="Bottom"
                   PopupAnimation="Fade">
                <Border Background="{DynamicResource IDE.ChromeRaisedBrush}"
                        BorderBrush="{DynamicResource IDE.BorderBrush}"
                        BorderThickness="1"
                        Padding="2">
                    <ScrollViewer CanContentScroll="True" VerticalScrollBarVisibility="Disabled" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle" />
                    </ScrollViewer>
                </Border>
            </Popup>
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="IsHighlighted" Value="True">
                <Setter TargetName="OuterBorder" Property="Background" Value="{DynamicResource IDE.HoverBrush}" />
                <Setter TargetName="OuterBorder" Property="BorderBrush" Value="{DynamicResource IDE.BorderBrush}" />
            </Trigger>
            <Trigger Property="IsSubmenuOpen" Value="True">
                <Setter TargetName="OuterBorder" Property="Background" Value="{DynamicResource IDE.HoverBrush}" />
                <Setter TargetName="OuterBorder" Property="BorderBrush" Value="{DynamicResource IDE.AccentBrush}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="{DynamicResource IDE.TextMutedBrush}" />
                <Setter TargetName="OuterBorder" Property="Opacity" Value="0.6" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <ControlTemplate x:Key="IDE.TopLevelMenuItemNoPopupTemplate" TargetType="{x:Type MenuItem}">
        <Border x:Name="OuterBorder"
                Background="{TemplateBinding Background}"
                BorderBrush="Transparent"
                BorderThickness="1"
                Padding="{TemplateBinding Padding}"
                SnapsToDevicePixels="True">
            <ContentPresenter ContentSource="Header"
                              RecognizesAccessKey="True"
                              VerticalAlignment="Center"
                              HorizontalAlignment="Left" />
        </Border>
        <ControlTemplate.Triggers>
            <Trigger Property="IsHighlighted" Value="True">
                <Setter TargetName="OuterBorder" Property="Background" Value="{DynamicResource IDE.HoverBrush}" />
                <Setter TargetName="OuterBorder" Property="BorderBrush" Value="{DynamicResource IDE.BorderBrush}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="{DynamicResource IDE.TextMutedBrush}" />
                <Setter TargetName="OuterBorder" Property="Opacity" Value="0.6" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <ControlTemplate x:Key="IDE.SubmenuItemTemplate" TargetType="{x:Type MenuItem}">
        <Border x:Name="OuterBorder"
                Background="{TemplateBinding Background}"
                BorderBrush="Transparent"
                BorderThickness="1"
                Padding="{TemplateBinding Padding}"
                SnapsToDevicePixels="True">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ContentPresenter ContentSource="Header"
                                  RecognizesAccessKey="True"
                                  VerticalAlignment="Center"
                                  HorizontalAlignment="Left" />
                <TextBlock Grid.Column="1"
                           Margin="24,0,0,0"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource IDE.TextMutedBrush}"
                           Text="{TemplateBinding InputGestureText}" />
            </Grid>
        </Border>
        <ControlTemplate.Triggers>
            <Trigger Property="IsHighlighted" Value="True">
                <Setter TargetName="OuterBorder" Property="Background" Value="{DynamicResource IDE.HoverBrush}" />
                <Setter TargetName="OuterBorder" Property="BorderBrush" Value="{DynamicResource IDE.AccentBrush}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="{DynamicResource IDE.TextMutedBrush}" />
                <Setter TargetName="OuterBorder" Property="Opacity" Value="0.6" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <ControlTemplate x:Key="IDE.SubmenuHeaderTemplate" TargetType="{x:Type MenuItem}">
        <Grid SnapsToDevicePixels="True">
            <Border x:Name="OuterBorder"
                    Background="{TemplateBinding Background}"
                    BorderBrush="Transparent"
                    BorderThickness="1"
                    Padding="{TemplateBinding Padding}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ContentPresenter ContentSource="Header"
                                      RecognizesAccessKey="True"
                                      VerticalAlignment="Center"
                                      HorizontalAlignment="Left" />
                    <Path Grid.Column="1"
                          Margin="20,0,0,0"
                          VerticalAlignment="Center"
                          Fill="{DynamicResource IDE.TextMutedBrush}"
                          Data="M 0 0 L 6 5 L 0 10 Z" />
                </Grid>
            </Border>
            <Popup x:Name="PART_Popup"
                   AllowsTransparency="True"
                   Focusable="False"
                   IsOpen="{Binding IsSubmenuOpen, RelativeSource={RelativeSource TemplatedParent}}"
                   Placement="Right"
                   PopupAnimation="Fade">
                <Border Background="{DynamicResource IDE.ChromeRaisedBrush}"
                        BorderBrush="{DynamicResource IDE.BorderBrush}"
                        BorderThickness="1"
                        Padding="2">
                    <ScrollViewer CanContentScroll="True" VerticalScrollBarVisibility="Disabled" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle" />
                    </ScrollViewer>
                </Border>
            </Popup>
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="IsHighlighted" Value="True">
                <Setter TargetName="OuterBorder" Property="Background" Value="{DynamicResource IDE.HoverBrush}" />
                <Setter TargetName="OuterBorder" Property="BorderBrush" Value="{DynamicResource IDE.AccentBrush}" />
            </Trigger>
            <Trigger Property="IsSubmenuOpen" Value="True">
                <Setter TargetName="OuterBorder" Property="Background" Value="{DynamicResource IDE.HoverBrush}" />
                <Setter TargetName="OuterBorder" Property="BorderBrush" Value="{DynamicResource IDE.AccentBrush}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="{DynamicResource IDE.TextMutedBrush}" />
                <Setter TargetName="OuterBorder" Property="Opacity" Value="0.6" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <Style TargetType="{x:Type MenuItem}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource IDE.TextBrush}" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Padding" Value="8,5" />
        <Setter Property="Template" Value="{StaticResource IDE.SubmenuItemTemplate}" />
        <Style.Triggers>
            <Trigger Property="Role" Value="TopLevelHeader">
                <Setter Property="Template" Value="{StaticResource IDE.TopLevelMenuItemTemplate}" />
                <Setter Property="Padding" Value="7,4" />
            </Trigger>
            <Trigger Property="Role" Value="TopLevelItem">
                <Setter Property="Template" Value="{StaticResource IDE.TopLevelMenuItemNoPopupTemplate}" />
                <Setter Property="Padding" Value="7,4" />
            </Trigger>
            <Trigger Property="Role" Value="SubmenuHeader">
                <Setter Property="Template" Value="{StaticResource IDE.SubmenuHeaderTemplate}" />
            </Trigger>
            <Trigger Property="Role" Value="SubmenuItem">
                <Setter Property="Template" Value="{StaticResource IDE.SubmenuItemTemplate}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="{x:Type Separator}">
        <Setter Property="Margin" Value="4,3" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Separator}">
                    <Border Height="1" Background="{DynamicResource IDE.BorderBrush}" SnapsToDevicePixels="True" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type ToolBarTray}">
        <Setter Property="Background" Value="{DynamicResource IDE.ChromeBrush}" />
    </Style>

    <Style TargetType="{x:Type ToolBar}">
        <Setter Property="Background" Value="{DynamicResource IDE.ChromeBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource IDE.TextBrush}" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>

    <Style x:Key="IDE.ButtonStyle" TargetType="{x:Type Button}">
        <Setter Property="Background" Value="{DynamicResource IDE.ChromeRaisedBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource IDE.TextBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource IDE.BorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="10,5" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border x:Name="ButtonBorder"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="3"
                            Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          RecognizesAccessKey="True" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ButtonBorder" Property="Background" Value="{DynamicResource IDE.HoverBrush}" />
                            <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="{DynamicResource IDE.AccentBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="ButtonBorder" Property="Background" Value="{DynamicResource IDE.SelectionBrush}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="{DynamicResource IDE.AccentBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource IDE.TextMutedBrush}" />
                            <Setter TargetName="ButtonBorder" Property="Background" Value="Transparent" />
                            <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="Transparent" />
                            <Setter Property="Opacity" Value="0.55" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type Button}" BasedOn="{StaticResource IDE.ButtonStyle}" />

    <Style x:Key="IDE.ToolbarButtonStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource IDE.ButtonStyle}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Margin" Value="1" />
    </Style>

    <Style x:Key="IDE.SmallButtonStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource IDE.ToolbarButtonStyle}">
        <Setter Property="Padding" Value="7,3" />
        <Setter Property="MinWidth" Value="28" />
    </Style>

    <Style TargetType="{x:Type StatusBar}">
        <Setter Property="Background" Value="{DynamicResource IDE.ChromeBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource IDE.TextMutedBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource IDE.BorderBrush}" />
        <Setter Property="BorderThickness" Value="0,1,0,0" />
    </Style>

    <Style TargetType="{x:Type StatusBarItem}">
        <Setter Property="Foreground" Value="{DynamicResource IDE.TextMutedBrush}" />
        <Setter Property="Padding" Value="8,2" />
    </Style>

    <Style TargetType="{x:Type GridSplitter}">
        <Setter Property="Background" Value="{DynamicResource IDE.BorderBrush}" />
        <Setter Property="ShowsPreview" Value="True" />
    </Style>

    <Style TargetType="{x:Type TabControl}">
        <Setter Property="Background" Value="{DynamicResource IDE.EditorBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource IDE.TextBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource IDE.BorderBrush}" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>

    <Style TargetType="{x:Type TabItem}">
        <Setter Property="Background" Value="{DynamicResource IDE.ChromeBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource IDE.TextMutedBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource IDE.BorderBrush}" />
        <Setter Property="Padding" Value="10,6" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type TabItem}">
                    <Border x:Name="TabBorder"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="0,0,1,1"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter ContentSource="Header"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          RecognizesAccessKey="True" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="TabBorder" Property="Background" Value="{DynamicResource IDE.HoverBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource IDE.TextBrush}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="TabBorder" Property="Background" Value="{DynamicResource IDE.EditorBrush}" />
                            <Setter TargetName="TabBorder" Property="BorderBrush" Value="{DynamicResource IDE.AccentBrush}" />
                            <Setter TargetName="TabBorder" Property="BorderThickness" Value="0,2,1,0" />
                            <Setter Property="Foreground" Value="{DynamicResource IDE.TextBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type TreeView}">
        <Setter Property="Foreground" Value="{DynamicResource IDE.TextBrush}" />
    </Style>

    <Style TargetType="{x:Type TreeViewItem}">
        <Setter Property="Foreground" Value="{DynamicResource IDE.TextBrush}" />
        <Setter Property="Padding" Value="2" />
    </Style>

    <Style TargetType="{x:Type ScrollBar}">
        <Setter Property="Background" Value="{DynamicResource IDE.EditorBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource IDE.ChromeRaisedBrush}" />
        <Setter Property="Width" Value="12" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ScrollBar}">
                    <Grid Background="{TemplateBinding Background}">
                        <Track x:Name="PART_Track"
                               Orientation="{TemplateBinding Orientation}"
                               IsDirectionReversed="True">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton x:Name="DecreaseButton"
                                              Command="{x:Static ScrollBar.PageUpCommand}"
                                              Focusable="False"
                                              Opacity="0" />
                            </Track.DecreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Background="{DynamicResource IDE.ChromeRaisedBrush}">
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="{x:Type Thumb}">
                                            <Border x:Name="ThumbBorder"
                                                    Margin="2"
                                                    CornerRadius="4"
                                                    Background="{TemplateBinding Background}" />
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="ThumbBorder" Property="Background" Value="{DynamicResource IDE.TextMutedBrush}" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton x:Name="IncreaseButton"
                                              Command="{x:Static ScrollBar.PageDownCommand}"
                                              Focusable="False"
                                              Opacity="0" />
                            </Track.IncreaseRepeatButton>
                        </Track>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Orientation" Value="Horizontal">
                            <Setter Property="Height" Value="12" />
                            <Setter Property="Width" Value="Auto" />
                            <Setter TargetName="PART_Track" Property="IsDirectionReversed" Value="False" />
                            <Setter TargetName="DecreaseButton" Property="Command" Value="{x:Static ScrollBar.PageLeftCommand}" />
                            <Setter TargetName="IncreaseButton" Property="Command" Value="{x:Static ScrollBar.PageRightCommand}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type TextBox}">
        <Setter Property="Background" Value="{DynamicResource IDE.ChromeRaisedBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource IDE.TextBrush}" />
        <Setter Property="CaretBrush" Value="{DynamicResource IDE.TextBrush}" />
        <Setter Property="SelectionBrush" Value="{DynamicResource IDE.SelectionBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource IDE.BorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="6,4" />
    </Style>

    <Style TargetType="{x:Type ListBox}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource IDE.TextBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource IDE.BorderBrush}" />
    </Style>

    <Style TargetType="{x:Type ListBoxItem}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource IDE.TextBrush}" />
        <Setter Property="Padding" Value="4,2" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ListBoxItem}">
                    <Border x:Name="ItemBorder"
                            Background="{TemplateBinding Background}"
                            Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource IDE.SelectionBrush}" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource IDE.HoverBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type CheckBox}">
        <Setter Property="Foreground" Value="{DynamicResource IDE.TextBrush}" />
    </Style>
</ResourceDictionary>
