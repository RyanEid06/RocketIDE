<Window x:Class="RocketIDE.App.Editor.QuickOpenDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Quick Open" Width="720" Height="440" MinWidth="520" MinHeight="320"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Loaded="Window_Loaded" PreviewKeyDown="Window_PreviewKeyDown">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBox x:Name="FilterBox" Padding="6,4" Margin="0,0,0,8"
                 ToolTip="Type part of a file name or relative path"
                 TextChanged="FilterBox_TextChanged" />
        <ListBox x:Name="FilesList" Grid.Row="1" MouseDoubleClick="FilesList_MouseDoubleClick">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Margin="4,3">
                        <TextBlock Text="{Binding FileName}" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding RelativePath}" FontSize="11" Foreground="{DynamicResource IDE.TextMutedBrush}" />
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        <DockPanel Grid.Row="2" Margin="0,8,0,0">
            <TextBlock VerticalAlignment="Center" Foreground="{DynamicResource IDE.TextMutedBrush}" Text="Enter opens selected file · Esc cancels" />
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button MinWidth="80" Margin="8,0,0,0" Content="Cancel" IsCancel="True" />
                <Button MinWidth="80" Margin="8,0,0,0" Content="Open" IsDefault="True" Click="Open_Click" />
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
