<UserControl x:Class="RocketIDE.App.Editor.EditorDocumentHost"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:avalonEdit="http://icsharpcode.net/sharpdevelop/avalonedit"
             Background="{DynamicResource IDE.EditorBrush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border x:Name="FindBar"
                Grid.Row="0"
                Visibility="Collapsed"
                Background="{DynamicResource IDE.ChromeBrush}"
                BorderBrush="{DynamicResource IDE.BorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="8">
            <StackPanel>
                <DockPanel LastChildFill="True">
                    <Button DockPanel.Dock="Right"
                            Style="{StaticResource IDE.SmallButtonStyle}"
                            Content="×"
                            ToolTip="Close search"
                            Click="CloseFind_Click" />
                    <Button DockPanel.Dock="Right"
                            Style="{StaticResource IDE.SmallButtonStyle}"
                            Content="↓"
                            ToolTip="Next match (Enter)"
                            Click="FindNext_Click" />
                    <Button DockPanel.Dock="Right"
                            Style="{StaticResource IDE.SmallButtonStyle}"
                            Content="↑"
                            ToolTip="Previous match (Shift+Enter)"
                            Click="FindPrevious_Click" />
                    <CheckBox x:Name="MatchCaseCheckBox"
                              DockPanel.Dock="Right"
                              Margin="10,0,8,0"
                              VerticalAlignment="Center"
                              Content="Match case" />
                    <TextBox x:Name="FindTextBox"
                             MinWidth="180"
                             VerticalContentAlignment="Center"
                             KeyDown="FindTextBox_KeyDown" />
                </DockPanel>

                <DockPanel x:Name="ReplaceControls" Margin="0,6,0,0" Visibility="Collapsed" LastChildFill="True">
                    <Button DockPanel.Dock="Right"
                            Style="{StaticResource IDE.SmallButtonStyle}"
                            MinWidth="82"
                            Content="Replace All"
                            Click="ReplaceAll_Click" />
                    <Button DockPanel.Dock="Right"
                            Style="{StaticResource IDE.SmallButtonStyle}"
                            MinWidth="70"
                            Content="Replace"
                            Click="Replace_Click" />
                    <TextBox x:Name="ReplaceTextBox"
                             MinWidth="180"
                             VerticalContentAlignment="Center" />
                </DockPanel>
            </StackPanel>
        </Border>

        <avalonEdit:TextEditor x:Name="Editor"
                               Grid.Row="1"
                               Background="{DynamicResource IDE.EditorBrush}"
                               Foreground="{DynamicResource IDE.TextBrush}"
                               LineNumbersForeground="{DynamicResource IDE.TextMutedBrush}"
                               FontFamily="Consolas"
                               FontSize="14"
                               ShowLineNumbers="True"
                               HorizontalScrollBarVisibility="Auto"
                               VerticalScrollBarVisibility="Auto"
                               PreviewKeyDown="Editor_PreviewKeyDown" />
    </Grid>
</UserControl>
