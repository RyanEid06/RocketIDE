<UserControl x:Class="RocketIDE.App.Editor.EditorDocumentHost"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:avalonEdit="http://icsharpcode.net/sharpdevelop/avalonedit"
             xmlns:diagnostics="clr-namespace:RocketIDE.Core.Diagnostics;assembly=RocketIDE.Core"
             Background="{DynamicResource IDE.EditorBrush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border x:Name="FindBar"
                Grid.Row="0"
                Visibility="Collapsed"
                Background="{DynamicResource IDE.ChromeBrush}"
                BorderBrush="{DynamicResource IDE.BorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="8">
            <StackPanel>
                <DockPanel LastChildFill="True">
                    <Button DockPanel.Dock="Right"
                            Style="{StaticResource IDE.SmallButtonStyle}"
                            Content="×"
                            ToolTip="Close search"
                            Click="CloseFind_Click" />
                    <Button DockPanel.Dock="Right"
                            Style="{StaticResource IDE.SmallButtonStyle}"
                            Content="↓"
                            ToolTip="Next match (Enter)"
                            Click="FindNext_Click" />
                    <Button DockPanel.Dock="Right"
                            Style="{StaticResource IDE.SmallButtonStyle}"
                            Content="↑"
                            ToolTip="Previous match (Shift+Enter)"
                            Click="FindPrevious_Click" />
                    <CheckBox x:Name="MatchCaseCheckBox"
                              DockPanel.Dock="Right"
                              Margin="10,0,8,0"
                              VerticalAlignment="Center"
                              Content="Match case" />
                    <TextBox x:Name="FindTextBox"
                             MinWidth="180"
                             VerticalContentAlignment="Center"
                             KeyDown="FindTextBox_KeyDown" />
                </DockPanel>

                <DockPanel x:Name="ReplaceControls" Margin="0,6,0,0" Visibility="Collapsed" LastChildFill="True">
                    <Button DockPanel.Dock="Right"
                            Style="{StaticResource IDE.SmallButtonStyle}"
                            MinWidth="82"
                            Content="Replace All"
                            Click="ReplaceAll_Click" />
                    <Button DockPanel.Dock="Right"
                            Style="{StaticResource IDE.SmallButtonStyle}"
                            MinWidth="70"
                            Content="Replace"
                            Click="Replace_Click" />
                    <TextBox x:Name="ReplaceTextBox"
                             MinWidth="180"
                             VerticalContentAlignment="Center" />
                </DockPanel>
            </StackPanel>
        </Border>

        <Border Grid.Row="1"
                Margin="0"
                Padding="10,6"
                Background="{DynamicResource IDE.ChromeRaisedBrush}"
                BorderBrush="{DynamicResource IDE.WarningBrush}"
                BorderThickness="0,0,0,1">
            <Border.Style>
                <Style TargetType="{x:Type Border}">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding DiagnosticState}" Value="{x:Static diagnostics:LiveDiagnosticDocumentState.Unsupported}">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <TextBlock Foreground="{DynamicResource IDE.WarningBrush}"
                       TextWrapping="Wrap"
                       Text="Live diagnostics are unavailable for this file because it exceeds Rocket's 4 MiB LSP document limit." />
        </Border>

        <Border Grid.Row="2"
                Padding="10,6"
                Background="{DynamicResource IDE.ChromeRaisedBrush}"
                BorderBrush="{DynamicResource IDE.WarningBrush}"
                BorderThickness="0,0,0,1">
            <Border.Style>
                <Style TargetType="{x:Type Border}">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding AllowLocalEditing}" Value="False">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <TextBlock Foreground="{DynamicResource IDE.WarningBrush}"
                       TextWrapping="Wrap"
                       Text="{Binding LargeFileReason}" />
        </Border>

        <avalonEdit:TextEditor x:Name="Editor"
                               Grid.Row="3"
                               Background="{DynamicResource IDE.EditorBrush}"
                               Foreground="{DynamicResource IDE.TextBrush}"
                               LineNumbersForeground="{DynamicResource IDE.TextMutedBrush}"
                               FontFamily="Consolas"
                               FontSize="14"
                               ShowLineNumbers="True"
                               HorizontalScrollBarVisibility="Auto"
                               VerticalScrollBarVisibility="Auto"
                               PreviewKeyDown="Editor_PreviewKeyDown"
                               PreviewTextInput="Editor_PreviewTextInput">
            <avalonEdit:TextEditor.Style>
                <Style TargetType="{x:Type avalonEdit:TextEditor}">
                    <Setter Property="IsReadOnly" Value="False" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding AllowLocalEditing}" Value="False">
                            <Setter Property="IsReadOnly" Value="True" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </avalonEdit:TextEditor.Style>
            <avalonEdit:TextEditor.ContextMenu>
                <ContextMenu>
                    <MenuItem Style="{StaticResource IDE.MenuItemStyle}" Header="Go to Definition" InputGestureText="F12" Click="Definition_Click" />
                    <MenuItem Style="{StaticResource IDE.MenuItemStyle}" Header="Find References" InputGestureText="Shift+F12" Click="References_Click" />
                    <Separator />
                    <MenuItem Style="{StaticResource IDE.MenuItemStyle}" Header="Rename Symbol..." InputGestureText="F2" Click="RenameSymbol_Click" />
                    <MenuItem Style="{StaticResource IDE.MenuItemStyle}" Header="Quick Fixes (server-provided)" InputGestureText="Ctrl+." Click="CodeActions_Click" />
                    <Separator />
                    <MenuItem Style="{StaticResource IDE.MenuItemStyle}" Header="Format Document" InputGestureText="Shift+Alt+F" Click="FormatDocument_Click" />
                </ContextMenu>
            </avalonEdit:TextEditor.ContextMenu>
        </avalonEdit:TextEditor>
    </Grid>
</UserControl>
