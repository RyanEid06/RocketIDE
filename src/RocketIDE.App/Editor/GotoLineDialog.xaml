<Window x:Class="RocketIDE.App.Editor.GotoLineDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Go to Line"
        Width="340"
        Height="160"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        WindowStyle="ToolWindow">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock x:Name="PromptText" Text="Line number" Margin="0,0,0,6" />
        <TextBox x:Name="LineTextBox" Grid.Row="1" MinWidth="180" />
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Style="{StaticResource IDE.ToolbarButtonStyle}" MinWidth="70" Content="Cancel" IsCancel="True" />
            <Button Style="{StaticResource IDE.ToolbarButtonStyle}" MinWidth="70" Margin="6,0,0,0" Content="Go" IsDefault="True" Click="Go_Click" />
        </StackPanel>
    </Grid>
</Window>
